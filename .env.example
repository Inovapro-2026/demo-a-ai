# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ORDER_SIGNING_SECRET: Optional HMAC secret for signing server-calculated order totals.
ORDER_SIGNING_SECRET=

# PIX_WEBHOOK_SECRET: Secret token used to verify incoming Pix payment provider webhooks.
PIX_WEBHOOK_SECRET=

# Optional demo credentials displayed on the /admin login screen (leave empty in production)
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

